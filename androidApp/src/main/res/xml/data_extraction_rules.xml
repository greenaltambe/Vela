<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: neither cloud backup nor device-to-device transfer carries the encrypted credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="vela_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="vela_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
