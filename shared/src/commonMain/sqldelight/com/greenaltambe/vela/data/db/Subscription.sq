CREATE TABLE Subscription (
    accountId TEXT NOT NULL,
    channelId TEXT NOT NULL,
    channelName TEXT NOT NULL,
    avatarUrl TEXT,
    subscribedAt INTEGER NOT NULL,
    notifyLevel TEXT NOT NULL DEFAULT 'PERSONALIZED',
    PRIMARY KEY (accountId, channelId)
);

selectForAccount:
SELECT * FROM Subscription WHERE accountId = ? ORDER BY channelName COLLATE NOCASE;

upsert:
INSERT OR REPLACE INTO Subscription(accountId, channelId, channelName, avatarUrl, subscribedAt)
VALUES (?, ?, ?, ?, ?);

setNotifyLevel:
UPDATE Subscription SET notifyLevel = ? WHERE accountId = ? AND channelId = ?;

notifyLevel:
SELECT notifyLevel FROM Subscription WHERE accountId = ? AND channelId = ?;

delete:
DELETE FROM Subscription WHERE accountId = ? AND channelId = ?;

isSubscribed:
SELECT COUNT(*) FROM Subscription WHERE accountId = ? AND channelId = ?;

count:
SELECT COUNT(*) FROM Subscription WHERE accountId = ?;

notifyLevels:
SELECT channelId, notifyLevel FROM Subscription WHERE accountId = ?;

setAllNotifyLevels:
UPDATE Subscription SET notifyLevel = ? WHERE accountId = ?;
