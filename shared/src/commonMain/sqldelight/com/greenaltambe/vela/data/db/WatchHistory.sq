-- One row per watch session, kept locally regardless of whether history is synced back to YouTube.
CREATE TABLE WatchHistory (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    accountId TEXT NOT NULL,
    videoId TEXT NOT NULL,
    channelId TEXT NOT NULL,
    title TEXT NOT NULL,
    watchedAt INTEGER NOT NULL,
    positionMs INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    watchedMs INTEGER NOT NULL,
    syncedToYoutube INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX WatchHistory_account_time ON WatchHistory(accountId, watchedAt DESC);
CREATE INDEX WatchHistory_account_video_time ON WatchHistory(accountId, videoId, watchedAt DESC);

selectRecent:
SELECT * FROM WatchHistory WHERE accountId = ? ORDER BY watchedAt DESC LIMIT ?;

selectLastForVideo:
SELECT * FROM WatchHistory WHERE accountId = ? AND videoId = ? ORDER BY watchedAt DESC LIMIT 1;

insert:
INSERT INTO WatchHistory(accountId, videoId, channelId, title, watchedAt, positionMs, durationMs, watchedMs, syncedToYoutube)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

-- A session's row is written once and then kept current while the video plays.
updateSession:
UPDATE WatchHistory SET watchedAt = ?, positionMs = ?, durationMs = ?, watchedMs = ? WHERE id = ?;

-- Rows saved without a title (a video opened from a link has none until it is looked up) get it, and the channel if that was blank too.
healMissing:
UPDATE WatchHistory SET title = ?, channelId = CASE WHEN channelId = '' THEN ? ELSE channelId END WHERE accountId = ? AND videoId = ? AND title = '';

lastInsertRowId:
SELECT last_insert_rowid();

totalWatchedMs:
SELECT COALESCE(SUM(watchedMs), 0) FROM WatchHistory WHERE accountId = ? AND watchedAt >= ? AND watchedAt < ?;

clearForAccount:
DELETE FROM WatchHistory WHERE accountId = ?;

selectAll:
SELECT * FROM WatchHistory WHERE accountId = ? ORDER BY watchedAt DESC LIMIT ?;

deleteById:
DELETE FROM WatchHistory WHERE id = ?;

deleteForVideo:
DELETE FROM WatchHistory WHERE accountId = ? AND videoId = ?;

watchedVideoIds:
SELECT DISTINCT videoId FROM WatchHistory WHERE accountId = ?;

-- Best progress per video over all its sessions, for the watched threshold.
watchedProgress:
SELECT videoId, MAX(positionMs) AS maxPositionMs, MAX(watchedMs) AS maxWatchedMs, MAX(durationMs) AS maxDurationMs
FROM WatchHistory WHERE accountId = ? GROUP BY videoId;
