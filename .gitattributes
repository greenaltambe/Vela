# Line endings: LF everywhere except Windows batch files.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Scripts must stay executable and LF.
gradlew text eol=lf
*.sh text eol=lf

# Binary files: never diffed or normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.so binary
*.dll binary
*.keystore binary
